#####################################################################
## Aliases
#####################################################################
alias history="history 0"
alias sudo="sudo "

# use bat if bat is available
if command -v bat &>/dev/null; then
    alias cat='bat --style="header-filename,header-filesize,grid" --paging="never"'
fi

# use neovim as vim or vi when available
if command -v nvim &>/dev/null; then
    alias vim="nvim"
    alias vi="nvim"
    export VISUAL="nvim"
    export EDITOR="nvim"
fi

# alias for kitty terminal
if [[ "$TERM" == "xterm-kitty" ]]; then
    alias ssh="kitty +kitten ssh"
    alias icat="kitty +kitten icat"
    alias diff="kitty +kitten diff"
fi

# alias for ghostty terminal
if [[ "$TERM" == "xterm-ghostty" ]]; then
    ghostty_ssh() {
        local host="$1"
        local control_path="/tmp/ghostty-ssh/control-%r@%h:%p"

        # Start a master connection if not already present
        if [[ ! -S "$control_path" ]]; then
            # Start a background master connection (will prompt for password once)
            ssh -o ControlMaster=auto -o ControlPersist=5m -o ControlPath="$control_path" -fN "$host"
        fi

        # Now all subsequent ssh commands will reuse the connection (no password prompt)
        if ssh -o ControlMaster=no -o ControlPath="$control_path" "$host" 'infocmp xterm-ghostty >/dev/null 2>&1'; then
            echo "Ghostty terminfo already present on remote."
        else
            echo "Copying ghostty terminfo to remote server..."
            infocmp -x xterm-ghostty | ssh -o ControlMaster=no -o ControlPath="$control_path" "$host" -- tic -x - >/dev/null 2>&1
            sleep 0.5
        fi

        ssh -t -o ControlMaster=no -o ControlPath="$control_path" "$host"
    }
    alias ssh="ghostty_ssh"
fi
