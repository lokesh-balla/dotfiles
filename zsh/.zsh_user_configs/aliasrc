#####################################################################
## Aliases
#####################################################################
alias history="history 0"
alias sudo="sudo "

# use bat if bat is available
if command -v bat &>/dev/null; then
    alias cat='bat --style="header-filename,header-filesize,grid" --paging="never"'
fi

# use neovim as vim or vi when available
if command -v nvim &>/dev/null; then
    alias vim="nvim"
    alias vi="nvim"
    export VISUAL="nvim"
    export EDITOR="nvim"
fi

# alias for kitty terminal
if [[ "$TERM" == "xterm-kitty" ]]; then
    alias ssh="kitty +kitten ssh"
    alias icat="kitty +kitten icat"
    alias diff="kitty +kitten diff"
fi

# alias for ghostty terminal
if [[ "$TERM" == "xterm-ghostty" ]]; then
    # Function to copy ghostty terminfo to remote servers using official method
    ghostty_ssh() {
        local host="$1"
        local control_path="/tmp/ghostty-ssh/control-${host}"

        # Create ghostty-ssh directory if it doesn't exist
        mkdir -p /tmp/ghostty-ssh

        # Check if control socket already exists (connection is already established)
        if [[ -S "$control_path" ]]; then
            echo "Reusing existing SSH connection..."
        else
            # Use the official ghostty terminfo copying command (redirect output to /dev/null)
            echo "Copying ghostty terminfo to remote server..."
            infocmp -x xterm-ghostty | ssh -o ControlMaster=auto -o ControlPersist=5m -o ControlPath="$control_path" "$host" -- tic -x - >/dev/null 2>&1

            # Small delay to ensure connection is established
            sleep 0.5
        fi

        # Connect with proper terminfo (reuse existing connection)
        ssh -t -o ControlMaster=no -o ControlPath="$control_path" "$host"
    }
    # Alias for the enhanced SSH function
    alias ssh="ghostty_ssh"
fi
